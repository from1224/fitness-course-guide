  "claims": [
    {"id":"claim:single-arm-cable-pulldown:cues","segmentId":"segment:BV1ofdnBZEi3:single-arm-cable-pulldown","kind":"cue","publicSummary":"凳与脚固定胸椎，躯干不后仰、不侧屈；回程让背阔拉长即可，别把肩胛完全送散。","sourceSpans":[[450,539],[347,368]],"verification":"subtitle_verified"},
    {"id":"claim:single-arm-cable-pulldown:dose","segmentId":"segment:BV1ofdnBZEi3:single-arm-cable-pulldown","kind":"dose","publicSummary":"原课：约12次，前三组留余量；末组约10次至力竭、休5秒再5次。","sourceSpans":[[65,75],[376,389]],"verification":"subtitle_verified"},
    {"id":"claim:single-arm-machine-row:cues","segmentId":"segment:BV1ofdnBZEi3:single-arm-machine-row","kind":"cue","publicSummary":"以背的有效拉长与回拉为准；不必为行程伸直手臂或把肩胛过度推出。","sourceSpans":[[1849,1899],[2803,3056]],"verification":"subtitle_verified"},
    {"id":"claim:single-arm-machine-row:breathing","segmentId":"segment:BV1ofdnBZEi3:single-arm-machine-row","kind":"technique","publicSummary":"胸部支撑时做长呼长吸，给胸廓进气与背部展开留空间；接近力竭仍优先控制。","sourceSpans":[[2861,2879]],"verification":"subtitle_verified"},
    {"id":"claim:neutral-grip-pulldown:cues","segmentId":"segment:BV1ofdnBZEi3:neutral-grip-pulldown","kind":"cue","publicSummary":"对握、微后倾，沿斜后方向拉；降肋收紧核心，背阔拉长即可，不追最大肩关节幅度。","sourceSpans":[[3194,3267]],"verification":"subtitle_verified"},
    {"id":"claim:neutral-grip-pulldown:dose","segmentId":"segment:BV1ofdnBZEi3:neutral-grip-pulldown","kind":"dose","publicSummary":"原课：8–12次或12–8次的重量范围均可，以动作感觉为主，不必力竭。","sourceSpans":[[3149,3155]],"verification":"subtitle_verified"},
    {"id":"claim:open-elbow-row:cues","segmentId":"segment:BV1ofdnBZEi3:open-elbow-row","kind":"cue","publicSummary":"开肘水平后拉补足中下斜方；躯干更后倾偏上部，更前坐偏下部，接近中立更像杠铃划船。","sourceSpans":[[3721,3852]],"verification":"subtitle_verified"},
    {"id":"claim:open-elbow-row:dose","segmentId":"segment:BV1ofdnBZEi3:open-elbow-row","kind":"dose","publicSummary":"原课：12–15次，以感觉为主。","sourceSpans":[[3998,4012]],"verification":"subtitle_verified"},
    {"id":"claim:knee-supported-cable-curl:cues","segmentId":"segment:BV1ofdnBZEi3:knee-supported-cable-curl","kind":"cue","publicSummary":"大臂放膝上略前置；下放到肘微屈仍有阻力即可，手腕勾起不塌，顶端主动收紧。","sourceSpans":[[4357,4493]],"verification":"subtitle_verified"},
    {"id":"claim:knee-supported-cable-curl:dose","segmentId":"segment:BV1ofdnBZEi3:knee-supported-cable-curl","kind":"dose","publicSummary":"原课：动作做到位时，3组已是很强刺激；质量越高，能承受的总容量越低。","sourceSpans":[[4623,4645]],"verification":"subtitle_verified"},
    {"id":"claim:back-band-warmup:cues","segmentId":"segment:BV1ofdnBZEi3:band-shoulder-circles","kind":"cue","publicSummary":"肩部环绕不向前顶；从眼前到肩后即可，别完全下落而丢失张力。","sourceSpans":[[4847,4880]],"verification":"subtitle_verified"},
    {"id":"claim:back-greatest-stretch:cues","segmentId":"segment:BV1ofdnBZEi3:worlds-greatest-stretch","kind":"cue","publicSummary":"伟大者伸展：同侧腿在前、对侧手穿过后吸气上旋；眼跟手指，约10次后换侧。","sourceSpans":[[4805,4844]],"verification":"subtitle_verified"},
    {"id":"claim:back-thoracic-rolling:cues","segmentId":"segment:BV1ofdnBZEi3:thoracic-rolling","kind":"cue","publicSummary":"泡沫轴放胸椎，手向上延伸并保持前锯肌对抗，再受控活动；别整个人松掉。","sourceSpans":[[4883,4942]],"verification":"subtitle_verified"},
    {"id":"claim:back-thoracic-extension:cues","segmentId":"segment:BV1ofdnBZEi3:thoracic-extension","kind":"cue","publicSummary":"第二项是胸椎伸展，用于放松菱形肌与中下斜方；与前一项胸椎滚动分开记录。","sourceSpans":[[4942,4959]],"verification":"subtitle_verified"},
    {"id":"claim:back-quadruped:cues","segmentId":"segment:BV1ofdnBZEi3:quadruped-hold","kind":"cue","publicSummary":"四足位支撑可进阶为膝离地：吸气顶高、呼气维持，不做大幅伸展，目的偏稳定。","sourceSpans":[[4959,5001]],"verification":"subtitle_verified"},
    {"id":"claim:back-wall-elbow:cues","segmentId":"segment:BV1ofdnBZEi3:wall-elbow","kind":"cue","publicSummary":"肘顶墙并与墙对抗；脚离墙越远难度越高，可引导背阔、圆肌、前锯与肋间肌参与。","sourceSpans":[[5001,5045]],"verification":"subtitle_verified"},
    {"id":"claim:arm-order","segmentId":"segment:BV18Jj66zEpV:leaning-cable-triceps-extension","kind":"technique","publicSummary":"原课先练三头：讲者认为若先练二头，手臂充血后可能难以伸直和收紧三头。","sourceSpans":[[0,14]],"verification":"subtitle_verified"},
    {"id":"claim:leaning-extension:cues","segmentId":"segment:BV18Jj66zEpV:leaning-cable-triceps-extension","kind":"cue","publicSummary":"微俯身，先肩伸再肘伸；滑轮可降至约下巴高，避免绳索卡住与发力不均。","sourceSpans":[[32,74]],"verification":"subtitle_verified"},
    {"id":"claim:leaning-extension:shoulder","segmentId":"segment:BV18Jj66zEpV:leaning-cable-triceps-extension","kind":"technique","publicSummary":"大臂可抬高，但要沉肩并稳住肩胛；抬过高导致肩胛前倾时应降低位置。","sourceSpans":[[88,106]],"verification":"subtitle_verified"},
    {"id":"claim:leaning-extension:range","segmentId":"segment:BV18Jj66zEpV:leaning-cable-triceps-extension","kind":"technique","publicSummary":"正常状态完成肘伸；配合肩伸、尺偏和主动内收，别让手臂外走而松掉长头。","sourceSpans":[[122,161]],"verification":"subtitle_verified"},
    {"id":"claim:leaning-extension:adjustment","segmentId":"segment:BV18Jj66zEpV:leaning-cable-triceps-extension","kind":"safety","publicSummary":"第一组肘部有明显压力时，先轻重量激活；字幕给出反手面对器械、约2/3行程的回退变体。","sourceSpans":[[76,84],[247,273]],"verification":"subtitle_verified"},
    {"id":"claim:lying-extension:dose","segmentId":"segment:BV18Jj66zEpV:incline-lying-barbell-extension","kind":"dose","publicSummary":"原课：每动作4组，其中1组适应组、3组正式组；本项偏离心段，不追求顶峰收缩。","sourceSpans":[[313,322],[438,445]],"verification":"subtitle_verified"},
    {"id":"claim:lying-extension:cues","segmentId":"segment:BV18Jj66zEpV:incline-lying-barbell-extension","kind":"cue","publicSummary":"凳约15°上斜；起始便让三头承受阻力，下放向额头，肘内收外旋、手腕顶住；向心回有效张力位即可。","sourceSpans":[[295,310],[324,369]],"verification":"subtitle_verified"},
    {"id":"claim:seated-cable-curl:cues","segmentId":"segment:BV18Jj66zEpV:seated-cable-curl","kind":"cue","publicSummary":"大臂放膝上，外旋半握；下放不必到底，以二头仍有张力的位置为起点，躯干别被器械带走。","sourceSpans":[[456,549]],"verification":"subtitle_verified"},
    {"id":"claim:seated-cable-curl:range","segmentId":"segment:BV18Jj66zEpV:seated-cable-curl","kind":"technique","publicSummary":"不为满行程低头把弯举做至视线之外；到看得见且能控制的收缩范围即可。","sourceSpans":[[557,572]],"verification":"subtitle_verified"},
    {"id":"claim:incline-curl:cues","segmentId":"segment:BV18Jj66zEpV:incline-dumbbell-curl","kind":"cue","publicSummary":"这是肩伸位弯举，与前项肩屈位互补；外旋须建立在内收之上，胸廓稳定，支撑不足可垫毛巾。","sourceSpans":[[594,606],[618,624],[750,797]],"verification":"subtitle_verified"},
    {"id":"claim:overhead-extension:cues","segmentId":"segment:BV18Jj66zEpV:single-arm-overhead-extension","kind":"cue","publicSummary":"单臂识别仍待确认：滑轮调低、转身握把；收核心不顶腰，向上而非向前发力，保持外旋、收肋与手腕支撑。","sourceSpans":[[805,856],[917,965]],"verification":"subtitle_verified"},
    {"id":"claim:overhead-extension:range","segmentId":"segment:BV18Jj66zEpV:single-arm-overhead-extension","kind":"technique","publicSummary":"此项字幕定位偏离心段：不要求完全收紧或完全伸直，主动内收并控制肋骨。","sourceSpans":[[975,1005]],"verification":"subtitle_verified"},
    {"id":"claim:hammer-curl:superset","segmentId":"segment:BV18Jj66zEpV:cable-hammer-curl","kind":"superset","publicSummary":"上一项单臂绳索颈后臂屈伸后不休息，直接接本项，构成小超级组。","sourceSpans":[[1009,1023]],"verification":"subtitle_verified"},
    {"id":"claim:hammer-curl:dose","segmentId":"segment:BV18Jj66zEpV:cable-hammer-curl","kind":"dose","publicSummary":"原课：约24次可完成的重量，多次数辅助／形体完整度取向，不是主增肌项。","sourceSpans":[[1056,1061],[1191,1205]],"verification":"subtitle_verified"},
    {"id":"claim:hammer-curl:cues","segmentId":"segment:BV18Jj66zEpV:cable-hammer-curl","kind":"cue","publicSummary":"对握锤式弯举，下半程不过度下放、上半程主动收紧并短暂停顿；躯干肩稳定，只做肘屈伸。","sourceSpans":[[1027,1056],[1090,1134]],"verification":"subtitle_verified"},
    {"id":"claim:hammer-curl:adjustment","segmentId":"segment:BV18Jj66zEpV:cable-hammer-curl","kind":"technique","publicSummary":"不后仰、不抬大臂；用重心略前移和多次数的可控收紧代替借力。","sourceSpans":[[1060,1078],[1153,1193]],"verification":"subtitle_verified"}
  ],
  "conflicts": []
